{
  "name": "cadence-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cadence Linux desktop shell (Tauri 2)",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --bundles rpm,appimage",
    "build:bin": "tauri build --no-bundle",
    "icons": "tauri icon ../public/icon-logo.png",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
