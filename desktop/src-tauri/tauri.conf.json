{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadence",
  "version": "0.1.0",
  "identifier": "ch.nicolab.cadence.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "appimage"],
    "category": "Productivity",
    "shortDescription": "Cadence desktop client",
    "longDescription": "Thin desktop shell around your Cadence server: tray icon, global quick-add shortcut and native notifications.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "rpm": {
        "release": "1",
        "files": {
          "/usr/share/applications/ch.nicolab.cadence.desktop.desktop": "linux/ch.nicolab.cadence.desktop.desktop"
        }
      }
    }
  }
}
