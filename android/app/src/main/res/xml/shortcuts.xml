<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_task"
        android:enabled="true"
        android:icon="@drawable/tasks_ic_notification"
        android:shortcutShortLabel="@string/tasks_quick_add_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="ch.nicolab.cadence"
            android:targetClass="ch.nicolab.cadence.tasks.quickadd.TaskQuickAddActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="capture_inbox"
        android:enabled="true"
        android:icon="@drawable/tasks_ic_notification"
        android:shortcutShortLabel="@string/tasks_shortcut_inbox">
        <intent
            android:action="ch.nicolab.cadence.action.CAPTURE_INBOX"
            android:targetPackage="ch.nicolab.cadence"
            android:targetClass="ch.nicolab.cadence.tasks.quickadd.TaskQuickAddActivity" />
    </shortcut>
</shortcuts>
