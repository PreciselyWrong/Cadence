{
  "_doc": "« Étaler sur 7 jours » of the overdue band (docs/03-upcoming-view.md), replayed by frontend/components/Upcoming/__tests__/spreadOverdue.test.ts and the Android Plan tests. Overdue tasks are sorted by priority (high, medium, low, none), then oldest due date, then uid. Each goes to the day, from today to today + 6, with the smallest load (sum of the estimated minutes of the tasks planned that day, 30 when a task has no positive estimate); a tie goes to the earliest day. The chosen day's load grows by the task's own minutes. `planned` lists the tasks already planned per day; `expect` lists every task with its day, in the order they were placed.",
  "cases": [
    {
      "name": "empty days: one task a day, highest priority first",
      "today": "2026-11-13",
      "overdue": [
        { "uid": "a", "priority": "high", "due_date": "2026-11-10", "estimated_minutes": null },
        { "uid": "b", "priority": null, "due_date": "2026-11-01", "estimated_minutes": null },
        { "uid": "c", "priority": "medium", "due_date": "2026-11-05", "estimated_minutes": null }
      ],
      "planned": {},
      "expect": [
        { "uid": "a", "date": "2026-11-13" },
        { "uid": "c", "date": "2026-11-14" },
        { "uid": "b", "date": "2026-11-15" }
      ]
    },
    {
      "name": "same priority: oldest due date first, then uid",
      "today": "2026-11-13",
      "overdue": [
        { "uid": "x", "priority": "low", "due_date": "2026-11-05", "estimated_minutes": null },
        { "uid": "w", "priority": "low", "due_date": "2026-11-05", "estimated_minutes": null },
        { "uid": "v", "priority": "low", "due_date": "2026-11-02", "estimated_minutes": null }
      ],
      "planned": {},
      "expect": [
        { "uid": "v", "date": "2026-11-13" },
        { "uid": "w", "date": "2026-11-14" },
        { "uid": "x", "date": "2026-11-15" }
      ]
    },
    {
      "name": "lightest day wins, a tie goes to the earliest day, today included",
      "today": "2026-11-13",
      "overdue": [
        { "uid": "r", "priority": "high", "due_date": "2026-11-01", "estimated_minutes": 45 },
        { "uid": "s", "priority": "medium", "due_date": "2026-11-01", "estimated_minutes": 30 }
      ],
      "planned": {
        "2026-11-12": [{ "estimated_minutes": 600 }],
        "2026-11-13": [{ "estimated_minutes": 60 }],
        "2026-11-14": [{ "estimated_minutes": 30 }, { "estimated_minutes": null }],
        "2026-11-15": [{ "estimated_minutes": 60 }],
        "2026-11-16": [{ "estimated_minutes": 60 }],
        "2026-11-17": [{ "estimated_minutes": 30 }],
        "2026-11-18": [{ "estimated_minutes": 60 }],
        "2026-11-19": [{ "estimated_minutes": 60 }],
        "2026-11-20": []
      },
      "expect": [
        { "uid": "r", "date": "2026-11-17" },
        { "uid": "s", "date": "2026-11-13" }
      ]
    },
    {
      "name": "the placed task's minutes add to its day; no estimate counts 30",
      "today": "2026-11-13",
      "overdue": [
        { "uid": "t1", "priority": null, "due_date": "2026-11-01", "estimated_minutes": 15 },
        { "uid": "t2", "priority": null, "due_date": "2026-11-02", "estimated_minutes": null },
        { "uid": "t3", "priority": null, "due_date": "2026-11-03", "estimated_minutes": 0 },
        { "uid": "t4", "priority": null, "due_date": "2026-11-04", "estimated_minutes": null },
        { "uid": "t5", "priority": null, "due_date": "2026-11-05", "estimated_minutes": null },
        { "uid": "t6", "priority": null, "due_date": "2026-11-06", "estimated_minutes": null },
        { "uid": "t7", "priority": null, "due_date": "2026-11-07", "estimated_minutes": null },
        { "uid": "t8", "priority": null, "due_date": "2026-11-08", "estimated_minutes": null },
        { "uid": "t9", "priority": null, "due_date": "2026-11-09", "estimated_minutes": null }
      ],
      "planned": {},
      "expect": [
        { "uid": "t1", "date": "2026-11-13" },
        { "uid": "t2", "date": "2026-11-14" },
        { "uid": "t3", "date": "2026-11-15" },
        { "uid": "t4", "date": "2026-11-16" },
        { "uid": "t5", "date": "2026-11-17" },
        { "uid": "t6", "date": "2026-11-18" },
        { "uid": "t7", "date": "2026-11-19" },
        { "uid": "t8", "date": "2026-11-13" },
        { "uid": "t9", "date": "2026-11-14" }
      ]
    },
    {
      "name": "a month boundary is crossed in date order",
      "today": "2026-11-28",
      "overdue": [
        { "uid": "m", "priority": "medium", "due_date": "2026-11-20T09:00:00.000Z", "estimated_minutes": 20 }
      ],
      "planned": {
        "2026-11-28": [{ "estimated_minutes": 30 }],
        "2026-11-29": [{ "estimated_minutes": 30 }],
        "2026-11-30": [{ "estimated_minutes": 30 }],
        "2026-12-01": [{ "estimated_minutes": 30 }],
        "2026-12-02": [{ "estimated_minutes": 30 }],
        "2026-12-03": [],
        "2026-12-04": []
      },
      "expect": [{ "uid": "m", "date": "2026-12-03" }]
    }
  ]
}
